# ====================================================================
# KRISHI SAATHI - GLOBAL ENVIRONMENT TEMPLATE
# Copy to backend/.env and frontend/.env.local respectively
# ====================================================================

# BACKEND (.env):
PROJECT_NAME="Krishi Saathi Backend API"
PORT=8000
SECRET_KEY="generate-a-strong-random-key"
DATABASE_URL="sqlite:///./krishi_saathi.db"
# Or PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Optional Cloud Integrations:
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
OPENWEATHER_API_KEY=""
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://krishi-saathi.vercel.app"

# FRONTEND (.env.local):
# In development:
VITE_API_BASE_URL="http://localhost:8000"
# In production on Vercel:
# VITE_API_BASE_URL="https://krishi-saathi-api.onrender.com"
