# Krishi Saathi Backend Environment Configuration
PROJECT_NAME="Krishi Saathi Backend API"
PORT=8000
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration:
# For local SQLite development (default):
DATABASE_URL="sqlite:///./krishi_saathi.db"
# For Render PostgreSQL or Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# Supabase Auth Configuration (optional if using Supabase directly)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# OpenWeather API Key (Free tier key from openweathermap.org)
OPENWEATHER_API_KEY=""

# Allowed Frontend Origins for CORS (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://krishi-saathi.vercel.app"
